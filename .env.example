# --- Base de datos (Neon: proyecto -> Connect -> cadena "pooled") ---
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST-pooler.REGION.aws.neon.tech/NOMBRE_BD?sslmode=require

# --- Autenticación del panel (Better Auth) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# URL pública del sitio (en local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Imágenes: Neon Object Storage (compatible con S3) ---
# Neon Console -> proyecto -> Object storage -> generar credencial
AWS_ENDPOINT_URL_S3=
# En Netlify los nombres AWS_* están reservados: usa S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY y S3_REGION.
# En local sirven igual los AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_REGION.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=uploads
# Opcional: minutos que debe tener una imagen sin remate para listarse como huérfana (por defecto 60)
ORPHAN_MIN_AGE_MINUTES=

# --- Solo para los scripts de usuario administrador (pnpm db:seed:admin / db:admin-password) ---
# Sin definir, el seed crea admin@remates.co con la clave de ejemplo Admin123! (cámbiala).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
